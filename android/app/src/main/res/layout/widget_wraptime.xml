<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌯 WrapTime"
            android:textColor="#F59E0B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_employee_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Employee"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Shifts container: 2 columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Column 1: Today's Shift -->
        <LinearLayout
            android:id="@+id/widget_today_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_today_branch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branch"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_today_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00 - 22:00"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_today_coworkers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solo Shift"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_today_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduled"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="auto"
                android:background="@drawable/widget_badge_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- Column 2: Upcoming / Tomorrow's Shift -->
        <LinearLayout
            android:id="@+id/widget_upcoming_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="10dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/widget_upcoming_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPCOMING"
                android:textColor="#A78BFA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_upcoming_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_upcoming_branch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branch"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_upcoming_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00 - 22:00"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_upcoming_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov 24"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:layout_marginTop="auto" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>